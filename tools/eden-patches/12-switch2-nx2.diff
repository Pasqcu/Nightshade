+            xmad(250, a, b, c, false, false, 0, immediate);
+            xmad(251, a, b, 255, true, false, 0, immediate);
+            xmad(251, a, b, 251, false, true, 0, immediate);
+            emit(base(0x5c18000000000000ULL) | (u64{251} << 8) |
+                 (u64{250} << 20) | (u64{16} << 39));
+        };
